<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFDFD"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/profile_portal"
            android:textStyle="bold" />

        <TextView
            android:accessibilityHeading="true"
            style="@style/Widget.StudentInfoApp.ProfileValue"
            android:layout_marginTop="24dp"
            android:text="@string/profile_title"
            android:textSize="34sp" />

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:layout_marginTop="8dp"
            android:text="@string/profile_description"
            android:textSize="16sp" />

        <LinearLayout
            style="@style/Widget.StudentInfoApp.ProfileCard"
            android:layout_marginTop="24dp">

            <TextView
                style="@style/Widget.StudentInfoApp.ProfileLabel"
                android:text="@string/profile_student_name" />

            <TextView
                android:id="@+id/profileName"
                style="@style/Widget.StudentInfoApp.ProfileValue"
                android:layout_marginTop="6dp"
                android:textSize="26sp"
                tools:text="Jon Bell" />
        </LinearLayout>

        <TextView
            android:accessibilityHeading="true"
            style="@style/Widget.StudentInfoApp.ProfileValue"
            android:layout_marginTop="24dp"
            android:text="@string/profile_academics"
            android:textSize="20sp" />

        <LinearLayout
            style="@style/Widget.StudentInfoApp.ProfileCard"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Widget.StudentInfoApp.ProfileLabel"
                android:text="@string/profile_student_number" />

            <TextView
                android:id="@+id/profileNumber"
                style="@style/Widget.StudentInfoApp.ProfileValue"
                android:layout_marginTop="6dp"
                tools:text="2024-100001" />

            <View style="@style/Widget.StudentInfoApp.ProfileDivider" />

            <TextView
                style="@style/Widget.StudentInfoApp.ProfileLabel"
                android:text="@string/profile_program" />

            <TextView
                android:id="@+id/profileProgram"
                style="@style/Widget.StudentInfoApp.ProfileValue"
                android:layout_marginTop="6dp"
                tools:text="BSCS-ML" />

            <View style="@style/Widget.StudentInfoApp.ProfileDivider" />

            <TextView
                style="@style/Widget.StudentInfoApp.ProfileLabel"
                android:text="@string/profile_year" />

            <TextView
                android:id="@+id/profileYear"
                style="@style/Widget.StudentInfoApp.ProfileValue"
                android:layout_marginTop="6dp"
                tools:text="3rd Year" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileEdit"
            style="@style/Widget.StudentInfoApp.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/profile_edit_title" />

        <TextView
            android:accessibilityHeading="true"
            style="@style/Widget.StudentInfoApp.ProfileValue"
            android:layout_marginTop="24dp"
            android:text="@string/profile_schedule_title"
            android:textSize="20sp" />

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:layout_marginTop="4dp"
            android:text="@string/profile_schedule_sample" />

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/profileScheduleDay"
            android:text="@string/profile_schedule_day" />

        <Spinner
            android:id="@id/profileScheduleDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/schedule_days"
            android:minHeight="48dp"
            android:prompt="@string/profile_schedule_day"
            android:saveEnabled="false"
            android:spinnerMode="dialog" />

        <LinearLayout
            style="@style/Widget.StudentInfoApp.ProfileCard"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/profileScheduleStatus"
                style="@style/Widget.StudentInfoApp.ProfileValue"
                android:accessibilityLiveRegion="polite"
                tools:text="4 classes" />

            <LinearLayout
                android:id="@+id/profileScheduleLessons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:listitem="@layout/item_schedule_lesson" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileSignOut"
            style="@style/Widget.StudentInfoApp.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/profile_sign_out" />

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/profile_footer"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
