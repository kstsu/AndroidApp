<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/profile_portal"
            android:textStyle="bold" />

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileValue"
            android:accessibilityHeading="true"
            android:layout_marginTop="24dp"
            android:text="@string/profile_edit_title"
            android:textSize="34sp" />

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:layout_marginTop="8dp"
            android:text="@string/profile_edit_description"
            android:textSize="16sp" />

        <LinearLayout
            style="@style/Widget.StudentInfoApp.ProfileCard"
            android:layout_marginTop="24dp">

            <TextView
                style="@style/Widget.StudentInfoApp.ProfileLabel"
                android:text="@string/profile_student_number" />

            <TextView
                android:id="@+id/editProfileNumber"
                style="@style/Widget.StudentInfoApp.ProfileValue"
                android:layout_marginTop="4dp"
                tools:text="2024-100001" />

            <TextView
                style="@style/Widget.StudentInfoApp.ProfileLabel"
                android:layout_marginTop="4dp"
                android:text="@string/profile_edit_number_note" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editProfileNameLayout"
            style="@style/Widget.StudentInfoApp.OutlinedInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/profile_student_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:minHeight="56dp"
                android:textSize="16sp"
                tools:text="Jon Bell" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editProfileProgramLayout"
            style="@style/Widget.StudentInfoApp.OutlinedInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/profile_program">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editProfileProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters"
                android:minHeight="56dp"
                android:textSize="16sp"
                tools:text="BSCS-ML" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editProfileYearLayout"
            style="@style/Widget.StudentInfoApp.OutlinedInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/profile_year"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/editProfileYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="16sp"
                tools:text="3rd Year" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editProfileSave"
            style="@style/Widget.StudentInfoApp.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/profile_edit_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editProfileCancel"
            style="@style/Widget.StudentInfoApp.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_edit_cancel" />

        <TextView
            style="@style/Widget.StudentInfoApp.ProfileLabel"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/profile_footer"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
